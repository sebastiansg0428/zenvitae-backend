JWT_EXPIRES_IN=8h

# Solo usadas por scripts/createAdmin.js para crear el primer administrador sin escribir credenciales en el código.
# Si no se definen, el script las pedirá por consola.
ADMIN_EMAIL=
ADMIN_PASSWORD=

